{
  "name": "actividad4-productos",
  "version": "1.0.0",
  "private": true,
  "description": "Gestión de productos con Express, MongoDB, autenticación JWT y pruebas Jest",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --coverage",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "db:check": "node scripts/check-database.js",
    "dev:demo": "node scripts/start-local-demo.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.12.2"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "mongodb-memory-server": "10.4.3",
    "supertest": "7.2.2"
  }
}
