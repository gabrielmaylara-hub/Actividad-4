# Copia este archivo a .env. No publiques .env en GitHub.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# Para MongoDB local. Para Atlas, reemplaza por la URI de tu propio cluster
# e indica actividad4 como nombre de la base de datos.
MONGODB_URI=mongodb://127.0.0.1:27017/actividad4

# Genera un valor aleatorio de al menos 32 caracteres. Ejemplo de comando:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Opcional: las pruebas de integracion pueden usar una base EXCLUSIVA de pruebas.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/actividad4_test
